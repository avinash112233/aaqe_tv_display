{
  "name": "aaqe_tv_display",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TV-friendly AAQE station forecast display (separate from african_dashboard)",
  "scripts": {
    "dev": "vite",
    "dev:bg": "sh scripts/dev-start.sh",
    "dev:stop": "sh scripts/dev-stop.sh",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npx vercel --prod"
  },
  "dependencies": {
    "dayjs": "^1.11.19",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "5.2.8"
  }
}
